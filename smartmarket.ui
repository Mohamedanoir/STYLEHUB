      <widget class="QWidget" name="PClient">
       <property name="styleSheet">
        <string notr="true">
QWidget#PClient { background-color: #f6f1e9; }
QPushButton[nav="true"] { color: #FFFFFF; background: transparent; border: none; text-align: left; padding-left: 20px; margin: 0px 6px; border-radius: 6px; font-family: "Segoe UI"; font-size: 13px; font-weight: 500; }
QPushButton[nav="true"]:hover { background-color: rgba(255, 255, 255, 0.12); }
QPushButton[nav="true"]:checked { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #E5C378, stop:1 #C89538); color: #08213B; font-weight: bold; }
QFrame#banner { background-color: #efe3cf; border: none; }
QLabel#bannerTitle { font-size: 38px; font-style: italic; font-weight: bold; color: #0b2a4a; }
QLabel#bannerSub { font-size: 15px; font-style: italic; color: #b08d57; }
QLabel#bannerQuote { font-size: 16px; font-style: italic; color: #b08d57; }
QGroupBox { background-color: white; border: 1px solid #e6dccb; border-radius: 8px; margin-top: 28px; font-weight: bold; font-size: 15px; color: #0b2a4a; }
QGroupBox::title { subcontrol-origin: margin; subcontrol-position: top left; left: 0px; padding: 6px 14px; background-color: #efe3cf; border-radius: 6px; }
QLineEdit, QComboBox, QDateEdit, QPlainTextEdit { background: white; border: 1px solid #ddd3c2; border-radius: 6px; padding: 6px; font-weight: normal; color: #222; }
QLabel[field="true"] { font-weight: bold; color: #0b2a4a; font-size: 13px; }
QPushButton#btnAjouterClient { background-color: #0b2a4a; color: white; font-weight: bold; padding: 10px; border-radius: 6px; }
QPushButton#btnModifierClient, QPushButton#btnAfficherClient { background-color: #d9dde2; color: #333; font-weight: bold; padding: 10px; border-radius: 6px; }
QPushButton#btnSupprimerClient { background-color: #efe3cf; color: #0b2a4a; font-weight: bold; padding: 10px; border-radius: 6px; }
QPushButton#btnReinitClient { background-color: white; border: 1px solid #e6dccb; padding: 6px 12px; border-radius: 6px; color: #0b2a4a; }
QPushButton#btnExportClient { background-color: #0b2a4a; color: white; font-weight: bold; padding: 8px 18px; border-radius: 6px; }
QTableWidget { background: white; border: 1px solid #e6dccb; gridline-color: #eee6d8; selection-background-color: #efe3cf; selection-color: #0b2a4a; }
QHeaderView::section { background-color: #f6f1e9; color: #0b2a4a; font-weight: bold; padding: 6px; border: none; border-bottom: 1px solid #e6dccb; }
QPushButton[page="true"] { background: white; border: 1px solid #e6dccb; border-radius: 6px; min-width: 30px; padding: 6px; color: #0b2a4a; }
QPushButton#btnPage1Client { background-color: #0b2a4a; color: white; }
QProgressBar { border: none; background-color: #ebeef2; border-radius: 5px; max-height: 10px; }
QProgressBar::chunk { background-color: #0b2a4a; border-radius: 5px; }
QFrame[card="true"] { background: white; border: 1px solid #eee6d8; border-radius: 6px; }
   </string>
       </property>
