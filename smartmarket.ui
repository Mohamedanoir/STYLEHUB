      <widget class="QWidget" name="PArticle">
       <property name="styleSheet">
        <string notr="true">QWidget#PArticle,#bodyArticle{background:#f7f1e8}
QLabel{color:#1d2a3a;background:transparent}
#side{background:#0a2a4a}
#side QPushButton{background:transparent;color:#FFFFFF;text-align:left;padding-left:20px;border:none;border-radius:6px;margin:0 6px;font-family:"Segoe UI";font-size:13px;font-weight:500;min-height:40px;max-height:40px}
#side QPushButton:hover{background:rgba(255,255,255,0.12)}
#side QPushButton:checked{background:qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #E5C378,stop:1 #C89538);color:#08213B;font-weight:bold}
#topArticle{background:white}
#topArticle QLabel{color:#1d2a3a}
QLineEdit{border:1px solid #e6dccd;border-radius:8px;padding:8px 10px;background:white;color:#1d2a3a;selection-background-color:#d9a566;selection-color:#1d2a3a}
#formPanelArticle,#listPanelArticle,#statsPanelArticle{background:white;border-radius:12px}
#formHeaderArticle,#listHeaderArticle,#statsHeaderArticle{background:#f1e4d3;border-top-left-radius:12px;border-top-right-radius:12px}
#lblFormTitleArticle,#lblListTitleArticle,#lblSortByArticle,#lblStatsTitleArticle{font:600 13pt Georgia;background:transparent}
#cardDonutArticle,#cardLineArticle,#cardBarsArticle{background:white;border:1px solid #efe6d8;border-radius:10px}
QComboBox,QDoubleSpinBox,QSpinBox,QDateEdit,QTextEdit{border:1px solid #e6dccd;border-radius:8px;padding:6px 8px;background:white;color:#1d2a3a;selection-background-color:#d9a566;selection-color:#1d2a3a}
QComboBox QAbstractItemView{background:white;color:#1d2a3a;selection-background-color:#f1e4d3;selection-color:#1d2a3a;border:1px solid #e6dccd}
QCalendarWidget QWidget{background:white;color:#1d2a3a}
QCalendarWidget QAbstractItemView{selection-background-color:#d9a566;selection-color:#1d2a3a}
#btnAddArticle,#btnPdfArticle{background:#0f2d55;color:white;border-radius:8px;font-weight:600;padding:0 14px}
#btnModArticle{background:#8993a2;color:white;border-radius:8px;font-weight:600}
#btnDelArticle{background:#f1e4d3;color:#5b3b18;border-radius:8px;font-weight:600}
#btnViewArticle{background:#e4e7ec;color:#0f2d55;border-radius:8px;font-weight:600}
#btnImgArticle{background:#e4e7ec;color:#0f2d55;border-radius:8px;font-weight:600;padding:6px 12px}
#lImgArticle{background:#fbf6ee;border:1px dashed #d9c3a3;border-radius:8px;color:#9aa3b0}
#btnResetArticle{background:transparent;color:#0f2d55;border:0;font-weight:600}
QHeaderView::section{background:#f1e4d3;color:#1d2a3a;border:0;padding:8px;font-weight:600}
QTableWidget{background:white;alternate-background-color:#fbf6ee;color:#1d2a3a;border:0;gridline-color:#efe6d8;selection-background-color:#f6e7d0;selection-color:#1d2a3a}
QTableWidget::item{padding:4px 6px}
QTableCornerButton::section{background:#f1e4d3;border:0}
QScrollBar:vertical{background:#f7f1e8;width:10px;border-radius:5px}
QScrollBar::handle:vertical{background:#d9c3a3;border-radius:5px;min-height:24px}
QScrollBar::add-line,QScrollBar::sub-line{height:0;width:0}
QMessageBox{background:white}
QMessageBox QLabel{color:#1d2a3a}
QMessageBox QPushButton{background:#0f2d55;color:white;border-radius:6px;padding:6px 16px;min-width:70px}
</string>
